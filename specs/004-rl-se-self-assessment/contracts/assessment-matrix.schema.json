{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hindermath/TinyCalc/specs/004-rl-se-self-assessment/contracts/assessment-matrix.schema.json",
  "title": "TinyCalc RL-SE Assessment Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "baseline", "sourceFiles", "rows", "summary"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "assessmentId": { "const": "rl-se-self-assessment-2026-09-05" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "baselineVersion", "manifestNormalizedSha256", "documentBindings"],
      "properties": {
        "manifestPath": { "const": "docs/secure-development/baseline-manifest.json" },
        "baselineVersion": { "type": "string", "minLength": 1 },
        "manifestNormalizedSha256": { "$ref": "#/$defs/digest" },
        "documentBindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "version", "normalizedSha256"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "version": { "type": "string", "minLength": 1 },
              "normalizedSha256": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "rows": {
      "type": "array",
      "minItems": 157,
      "maxItems": 157,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": {
      "type": "object",
      "required": ["total", "byDisposition", "byFamily"],
      "properties": {
        "total": { "const": 157 },
        "byDisposition": { "type": "object" },
        "byFamily": { "type": "object", "minProperties": 12, "maxProperties": 12 }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "not": { "pattern": "^[\\\\/]" } },
        { "not": { "pattern": "^[A-Za-z]:" } },
        { "not": { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" } }
      ]
    },
    "nonBlank": { "type": "string", "pattern": "^.*\\S.*$" },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourcePath", "disposition", "applicability", "implementationStatus", "rationale", "evidence", "openMarker", "owner", "followUp", "priority", "risk", "reevaluationTrigger", "residualRisk", "humanOnly", "humanDecisionEvidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^CL-(0[1-9]|1[0-2])-[0-9]{2}$" },
        "sourcePath": { "$ref": "#/$defs/relativePath" },
        "disposition": { "enum": ["Applicable", "AlreadySatisfied", "N/A", "Open", "FollowUp"] },
        "applicability": { "enum": ["Applicable", "N/A", "Open"] },
        "implementationStatus": { "enum": ["Fulfilled", "Partly Fulfilled", "Not Fulfilled", "Not Assessed"] },
        "rationale": { "$ref": "#/$defs/nonBlank" },
        "evidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "openMarker": { "type": "boolean" },
        "owner": { "$ref": "#/$defs/nonBlank" },
        "followUp": { "$ref": "#/$defs/nonBlank" },
        "priority": { "enum": ["Critical", "High", "Medium", "Low", "None"] },
        "risk": { "$ref": "#/$defs/nonBlank" },
        "reevaluationTrigger": { "$ref": "#/$defs/nonBlank" },
        "residualRisk": { "$ref": "#/$defs/nonBlank" },
        "humanOnly": { "type": "boolean" },
        "humanDecisionEvidence": { "const": "NotProvided" }
      },
      "allOf": [
        {
          "if": { "properties": { "humanOnly": { "const": true } }, "required": ["humanOnly"] },
          "then": {
            "properties": {
              "disposition": { "enum": ["Open", "FollowUp"] },
              "implementationStatus": { "enum": ["Partly Fulfilled", "Not Fulfilled", "Not Assessed"] },
              "humanDecisionEvidence": { "const": "NotProvided" }
            }
          }
        }
      ]
    }
  }
}
