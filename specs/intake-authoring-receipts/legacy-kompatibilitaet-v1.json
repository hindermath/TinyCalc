    {
      "id": "IAD001",
      "status": "Answered",
      "question": "Should legacy parity and structural spreadsheet features share one intake?",
      "answer": "No. Legacy compatibility is completed first and structural spreadsheet extensions follow separately.",
      "evidence": "Explicit user decision."
    },
    {
      "id": "IAD002",
      "status": "Answered",
      "question": "Which MCS variants are supported?",
      "answer": "Version 1 imports the evidenced standard and 8087 variants; JSON is the only write format.",
      "evidence": "Explicit user decision."
    },
    {
      "id": "IAD003",
      "status": "Answered",
      "question": "How is historical platform-specific behaviour treated?",
      "answer": "Useful semantics receive accessible modern paths; obsolete device, path, scan-code, and video mechanics are non-goals.",
      "evidence": "Approved source comparison."
    },
    {
      "id": "IAD004",
      "status": "Answered",
      "question": "What counts as an authentic fixture?",
      "answer": "A file generated and read back with the original matching compiler toolchain under a reproducible DOS environment is compiler-authentic.",
      "evidence": "Explicit user selection."
    },
    {
      "id": "IAD005",
      "status": "Answered",
      "question": "How is TURBOBCD.COM treated?",
