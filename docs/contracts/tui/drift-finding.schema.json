{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "drift-finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "sourceRef",
    "capabilityRef",
    "expected",
    "actual",
    "category",
    "blocking",
    "owner",
    "followUp"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "capabilityRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "actual": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "DocumentationDefect",
        "ContractViolation",
        "TestWeakening",
        "SourceDrift",
        "BlockedPreflight"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "followUp": {
      "type": "string",
      "minLength": 1
    }
  }
}
