{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate-proofs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commit",
    "workingTreeDigest",
    "contractDigest",
    "pinDecisionDigest",
    "impactDecisionDigest",
    "payloadDigest",
    "gates"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "workingTreeDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contractDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pinDecisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "impactDecisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "outcome",
          "reviewer",
          "command",
          "startedAt",
          "finishedAt",
          "artifactRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "Automated",
              "HumanSupplement",
              "IndependentReview"
            ]
          },
          "outcome": {
            "enum": [
              "Pass",
              "Fail",
              "Skipped",
              "NotAssessed"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "artifactRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
