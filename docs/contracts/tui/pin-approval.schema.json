{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pin-approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["graphDigest", "approvalRef"],
  "properties": {
    "graphDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approvalRef": { "type": "string", "pattern": "^.+#sha256=[a-f0-9]{64}$" }
  }
}
