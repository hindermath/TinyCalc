{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract-history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commit", "contractDigest", "authorities"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorities": { "type": "array", "items": { "$ref": "#/$defs/authority" } },
    "additions": { "type": "array", "items": { "$ref": "#/$defs/addition" } }
  },
  "$defs": {
    "addition": {
      "type": "object", "additionalProperties": false,
      "required": ["requirementId", "testName", "testSourceRef", "redExecutionRef", "redCommit", "implementationCommit", "productPaths"],
      "properties": {
        "requirementId": { "type": "string", "pattern": "^FR-[0-9]{3}$" },
        "testName": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "testSourceRef": { "type": "string", "pattern": "^tests/[A-Za-z0-9_./-]+\\.cs#sha256=[a-f0-9]{64}$" },
        "redExecutionRef": { "type": "string", "pattern": "^.+#sha256=[a-f0-9]{64}$" },
        "redCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "implementationCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "productPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^src/[A-Za-z0-9_./-]+\\.cs$" } }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "affectedIds", "kind", "approvalRef", "date", "successorIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "affectedIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "affectedPathIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "kind": { "enum": ["Deprecation", "BreakingChange"] },
        "approvalRef": { "type": "string", "pattern": "^.+#sha256=[a-f0-9]{64}$" },
        "date": { "type": "string", "format": "date" },
        "successorIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
