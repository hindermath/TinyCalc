{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "change-authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "affectedIds",
    "kind",
    "approvalRef",
    "date",
    "successorIds"
  ],
  "properties": {
    "affectedPathIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "affectedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "enum": [
        "Deprecation",
        "BreakingChange"
      ]
    },
    "approvalRef": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "successorIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
